{
  "name": "LTM Post-Turn Capture",
  "version": "1.0.0",
  "description": "Records agent activity to LTM memory store after each turn",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "make checkpoint for your memeory"
  },
  "enabled": true,
  "workspaceFolderName": "PortfolioDV",
  "shortName": "ltm-postturn-capture"
}